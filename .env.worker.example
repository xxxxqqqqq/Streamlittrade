# Copy this file to .env.worker. Never commit the real credentials.
# SSH mode works behind Wi-Fi/mobile hotspots because the tunnel is initiated
# outbound by this machine. VPN mode may instead use the cloud private address.
WORKER_TRANSPORT=ssh
SSH_HOST=8.134.107.95
SSH_USER=root
SSH_PRIVATE_KEY_PATH=C:/Users/we/Downloads/quantforge2.pem

QUANT_APP_ENV=production
QUANT_DATABASE_URL=postgresql+psycopg://quant_worker:REPLACE_ME@secure-tunnel:15432/quant
QUANT_REDIS_URL=redis://quant_worker:REPLACE_ME@secure-tunnel:16379/0
QUANT_OBJECT_STORAGE_ENDPOINT=http://secure-tunnel:19000
QUANT_OBJECT_STORAGE_ACCESS_KEY=REPLACE_ME
QUANT_OBJECT_STORAGE_SECRET_KEY=REPLACE_ME
QUANT_OBJECT_STORAGE_BUCKET=quant-artifacts

# Split routing is reversible: cloud light worker consumes quant-light while
# this machine consumes only quant-heavy.
QUANT_QUEUE_MODE=split
QUANT_WORKER_QUEUES=quant-heavy
QUANT_WORKER_NAME=laptop-worker-01
QUANT_HEAVY_JOB_TIMEOUT_SECONDS=28800
QUANT_WORKER_LEASE_SECONDS=1800
QUANT_WORKER_DATA_DIR=/var/lib/quantforge-worker
QUANT_OBJECT_STORAGE_RETRY_ATTEMPTS=5

# Docker Desktop resource limits for the current ~22 GiB laptop.
WORKER_MEMORY_LIMIT=16g
WORKER_CPU_LIMIT=8
WORKER_DATA_HOST_PATH=./.worker-data
