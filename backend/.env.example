# 复制为项目根目录 .env 后仅用于本地开发，不要提交真实密码或云密钥。
QUANT_APP_ENV=development
QUANT_DATABASE_URL=postgresql+psycopg://quant:quant_dev_password@localhost:5432/quant
QUANT_REDIS_URL=redis://localhost:6379/0
QUANT_OBJECT_STORAGE_ENDPOINT=http://localhost:9000
QUANT_OBJECT_STORAGE_ACCESS_KEY=quant_local
QUANT_OBJECT_STORAGE_SECRET_KEY=change_this_local_secret
QUANT_OBJECT_STORAGE_BUCKET=quant-artifacts
QUANT_CORS_ORIGINS=["http://localhost:5173"]
